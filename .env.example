# Copia este archivo como ".env" y rellena tus datos.
# El archivo .env NO se sube a GitHub (está en .gitignore): tus claves quedan privadas.
# En el hosting, configura estas mismas variables en su panel en lugar de subir el archivo.

# Contraseña para entrar en el modo edición de la web.
ADMIN_PASSWORD=cambia-esta-contraseña

# Claves de Cloudinary: las encuentras en https://console.cloudinary.com → Dashboard (API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Carpeta de Cloudinary donde se guardan las fotos (opcional, por defecto "portfolio").
# CLOUDINARY_FOLDER=portfolio
